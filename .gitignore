# ==============================
# FailureLab .gitignore
# ==============================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Downloaded datasets
examples/downloaded_data/

# Generated FailureLab reports
examples/reports/

# Dataset archives
*.tar.gz
*.tgz
*.zip

# IDE / editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Coverage
.coverage
htmlcov/
.coverage.*

# Temporary files
*.tmp
*.temp